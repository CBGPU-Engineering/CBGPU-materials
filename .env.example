CBGPU_SUPABASE_URL=http://127.0.0.1:54321
CBGPU_SUPABASE_ANON_KEY=replace-with-your-public-client-key
CBGPU_MATERIALS_DIR=/tmp/cbgpu-materials-dev
CBGPU_MATERIALS_ORIGINS=http://localhost:3000
CBGPU_MATERIALS_QUOTA_BYTES=1073741824

# Optional completed-object backend; absent/local preserves the existing disk layout.
CBGPU_MATERIALS_STORAGE_BACKEND=local
# S3 mode requires explicit single-writer acknowledgement if writes are enabled.
# CBGPU_MATERIALS_S3_SINGLE_WRITER=1
# CBGPU_MATERIALS_S3_BUCKET=private-existing-bucket
# CBGPU_MATERIALS_S3_REGION=ap-northeast-2
# CBGPU_MATERIALS_S3_PREFIX=materials-v1
# Optional compatible endpoint; HTTPS required outside explicitly opted-in private fixtures.
# CBGPU_MATERIALS_S3_ENDPOINT=https://s3.ap-northeast-2.amazonaws.com
# CBGPU_MATERIALS_S3_ALLOW_HTTP=0
# Credentials use the standard AWS environment/instance role credential providers.
# Keep AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_SESSION_TOKEN private.
